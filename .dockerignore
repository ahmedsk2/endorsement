# Never ship secrets, local state, or the dev toolchain into the image.
.env
.env.*
!.env.example
.git
.github
node_modules
vendor
storage/logs/*
storage/backups/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
# Allow-listing individual subpaths let a test fixture signature PNG ship inside the
# production image. Exclude the whole of testing/ and the private app disk: nothing under
# storage/app belongs in a layer — it is a runtime volume.
storage/framework/testing
# Same policy one level down: a package's test corpus is not production cargo.
packages/*/test
storage/app/private
storage/app/public
# Built with DEV dependencies present: shipping it makes Laravel load providers
# (e.g. Pail) that do not exist in a --no-dev vendor tree.
bootstrap/cache/*.php
database/*.sqlite*
public/build
public/hot
tests
test-results
playwright-report
docs
.claude
*.md
