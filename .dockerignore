# Never ship secrets, local state, or the dev toolchain into the image.
.env
.env.*
!.env.example
.git
.github
node_modules
vendor
storage/logs/*
storage/backups/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
# Built with DEV dependencies present: shipping it makes Laravel load providers
# (e.g. Pail) that do not exist in a --no-dev vendor tree.
bootstrap/cache/*.php
database/*.sqlite*
public/build
public/hot
tests
test-results
playwright-report
docs
.claude
*.md
