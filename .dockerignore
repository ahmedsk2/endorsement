# Never ship secrets, local state, or the dev toolchain into the image.
.env
.env.*
!.env.example
.git
.github
node_modules
vendor
storage/logs/*
storage/backups/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
# Allow-listing individual subpaths let a test fixture signature PNG ship inside the
# production image. Exclude the whole of testing/ and the private app disk: nothing under
# storage/app belongs in a layer — it is a runtime volume.
storage/framework/testing
# Same policy one level down: a package's test corpus is not production cargo.
packages/*/test
# Nor is the engine's Node bundle (P2 Task 23). It is gitignored, so whether it exists at all
# depends on whether the machine running `docker build` happened to run `npm run build:engine` —
# which is precisely the shape of Task 2's finding, where the image carried a different resolution
# from the one CI produced. The image has no caller for it either: services/engine is P3.
packages/*/dist
storage/app/private
storage/app/public
# Built with DEV dependencies present: shipping it makes Laravel load providers
# (e.g. Pail) that do not exist in a --no-dev vendor tree.
bootstrap/cache/*.php
database/*.sqlite*
public/build
public/hot
tests
test-results
playwright-report
docs
.claude
*.md
